#!/usr/bin/env bash
# Run a skill's eval cases from evals/<skill>/ with `claude plugin eval`.
# `claude plugin eval` needs the cases inside the skill folder and rejects a
# symlinked evals/, so this runs a temporary copy of the skill with the cases
# copied in, then moves the results to evals/<skill>/results/.
# Usage: scripts/eval-skill <skill> [--force-skill] [claude plugin eval options...]
# --force-skill tells the agent to use the skill when it is available, so a
# with-skill run measures the skill's effect once loaded rather than whether
# the agent loads it. It leaves out cases that check the skill does not load.
set -euo pipefail

usage="usage: scripts/eval-skill <skill> [--force-skill] [claude plugin eval options...]"
root="$(cd "$(dirname "$0")/.." && pwd)"
skill="${1:?$usage}"
shift

force=0
args=()
for arg in "$@"; do
  if [[ "$arg" == --force-skill ]]; then force=1; else args+=("$arg"); fi
done

[[ "$skill" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "skill must be a folder name such as write-agent-instructions" >&2; exit 1; }
[[ -f "$root/$skill/SKILL.md" ]] || { echo "no skill at $skill/SKILL.md" >&2; exit 1; }
[[ -d "$root/evals/$skill" ]] || { echo "no eval cases in evals/$skill" >&2; exit 1; }
# The copies below are cleaned with rm -rf, which would follow a copied symlink.
[[ ! -L "$root/$skill" && ! -L "$root/evals/$skill" ]] || { echo "$skill or evals/$skill is a symlink" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT TERM

# The copy keeps the skill's folder name, which is the name graders match.
cp -R "$root/$skill" "$work/$skill"
rm -rf "$work/$skill/evals"
cp -R "$root/evals/$skill" "$work/$skill/evals"
rm -rf "$work/$skill/evals/results"

if (( force )); then
  for case_dir in "$work/$skill/evals"/*/; do
    [[ -f "$case_dir/prompt.md" ]] || continue
    # A case that expects the skill not to load (a Skill grader with max: 0) is a near-miss.
    near_miss=0
    for grader in "$case_dir"graders/*.md; do
      if grep -q '^tool: Skill$' "$grader" && grep -q '^max: 0$' "$grader"; then near_miss=1; fi
    done
    if (( near_miss )); then
      rm -rf "$case_dir"
      echo "Skipped near-miss case $(basename "$case_dir")" >&2
      continue
    fi
    # Conditional, so the without-skill run is not asked to load a skill it lacks.
    printf '\nIf a skill named %s is available, load it with the Skill tool before you start.\n' "$skill" >>"$case_dir/prompt.md"
  done
fi

status=0
# Haiku is the agent under test, so a skill's effect shows on a weaker model;
# a strong model judges. Options after the skill name come later and override these.
claude plugin eval "$work/$skill" --model claude-haiku-5-5 --judge-model claude-opus-5-5 ${args[@]+"${args[@]}"} || status=$?

if [[ -d "$work/$skill/evals/results" ]]; then
  mkdir -p "$root/evals/$skill/results"
  cp -R "$work/$skill/evals/results/." "$root/evals/$skill/results/"
  echo "Results copied to evals/$skill/results/" >&2
fi
exit "$status"
