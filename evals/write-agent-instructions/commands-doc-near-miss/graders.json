{
  "trigger_only": true,
  "expect_skill_loaded": {
    "with": false,
    "without": false
  },
  "graders": [
    {
      "name": "adds-standup",
      "type": "regex",
      "path": "docs/commands.md",
      "pattern": "/standup",
      "flags": "i",
      "match": "contains",
      "description": "The doc lists the new command."
    },
    {
      "name": "keeps-existing",
      "type": "regex",
      "path": "docs/commands.md",
      "pattern": "/changelog[\\s\\S]*/release-notes",
      "flags": "i",
      "match": "contains",
      "description": "Existing entries survive."
    }
  ]
}
