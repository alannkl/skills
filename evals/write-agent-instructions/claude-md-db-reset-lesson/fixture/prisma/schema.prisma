generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  priceCents Int
  stock      Int         @default(0)
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  email     String
  status    String      @default("pending")
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  priceCents Int
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}
