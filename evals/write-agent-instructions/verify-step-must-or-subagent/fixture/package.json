{
  "name": "orders-api",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down --steps 1",
    "db:status": "node scripts/migrate.js status",
    "db:psql": "docker compose exec db psql -U orders orders",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
